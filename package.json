{
  "name": "ikanban",
  "displayName": "iKanban",
  "description": "Local Kanban board for VS Code with portable YAML files and an AI-ready SKILL.md for local LLM workflows.",
  "version": "0.3.1",
  "publisher": "ikanban",
  "license": "MIT",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#262e3e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/igorsantos314/ikanban-vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/igorsantos314/ikanban-vscode-extension/issues"
  },
  "homepage": "https://github.com/igorsantos314/ikanban-vscode-extension#readme",
  "engines": {
    "vscode": "^1.147.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "kanban",
    "tasks",
    "yaml",
    "local",
    "ai",
    "llm",
    "sdd"
  ],
  "activationEvents": [
    "onWebviewPanel:ikanban.board"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "ikanban.initialize",
        "title": "Initialize Board",
        "category": "iKanban"
      },
      {
        "command": "ikanban.open",
        "title": "Open Board",
        "category": "iKanban"
      },
      {
        "command": "ikanban.createTask",
        "title": "Create New Task",
        "category": "iKanban"
      },
      {
        "command": "ikanban.validate",
        "title": "Validate Board",
        "category": "iKanban"
      },
      {
        "command": "ikanban.refresh",
        "title": "Refresh Board",
        "category": "iKanban"
      },
      {
        "command": "ikanban.installAgentSkill",
        "title": "Install AI Skill",
        "category": "iKanban"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ikanban",
          "title": "iKanban",
          "icon": "resources/ikanban.svg"
        }
      ]
    },
    "views": {
      "ikanban": [
        {
          "id": "ikanban.home",
          "name": "iKanban",
          "type": "webview",
          "icon": "resources/ikanban.svg"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs');for (const dir of ['out','dist']) fs.rmSync(dir,{recursive:true,force:true})\"",
    "vscode:prepublish": "npm run build",
    "build:extension": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "build:webview": "vite build",
    "build": "npm run build:extension && npm run build:webview",
    "compile": "npm run build:extension",
    "watch": "tsc -w -p tsconfig.json",
    "check:types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json",
    "lint": "eslint src vite.config.ts vitest.config.ts vitest.setup.ts",
    "test:unit": "vitest run",
    "test:integration": "npm run build && vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "check": "npm run check:types && npm run lint && npm run test:unit",
    "check:marketplace": "node scripts/check-marketplace.mjs",
    "package": "npm run build && vsce package",
    "build:release": "node scripts/build-release.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.146.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.1.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
